{
  "name": "decky-apps-manager",
  "version": "0.1.0",
  "display_name": "Apps Manager",
  "description": "Check for and apply updates to your Flatpak apps (including ones installed via Discover) and Gearlever-managed AppImages, and discover/install new ones from either — all from Steam's Quick Access menu.",
  "type": "module",
  "scripts": {
    "version": "node -e \"const fs=require('fs');const p='./plugin.json';const o=JSON.parse(fs.readFileSync(p));o.version=process.env.npm_package_version;fs.writeFileSync(p,JSON.stringify(o,null,2)+'\\n');\" && git add plugin.json",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "fix:prettier": "prettier --config .prettierrc --write ./src",
    "fix:eslint": "eslint --fix src --ext .ts,.tsx",
    "check:prettier": "prettier ./src --check",
    "check:eslint": "eslint src --ext .ts,.tsx",
    "init": "node scripts/init-template.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moi952/decky-apps-manager.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck"
  ],
  "author": "moi952",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/moi952/decky-apps-manager/issues"
  },
  "homepage": "https://github.com/moi952/decky-apps-manager#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@moi952/decky-ui-kit": "^0.4.0",
    "i18next": "^25.8.13",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
